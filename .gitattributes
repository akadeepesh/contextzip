# Store text with LF line endings in the repository, whatever each
# contributor's OS or core.autocrlf setting. Checkouts still get native
# line endings where git is configured for them.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touch binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.mp4 binary
*.whl binary

# The vendored tokenizer vocabulary: byte-exact or its hash check fails.
contextzip/data/tiktoken/* binary
